{
  "version": 4,
  "configurations": [
    {
      "name": "Mac (wasi-sdk C++17 stdlib)",
      "compilerPath": "${env:HOME}/.local/wasi-sdk/bin/clang++",
      "cppStandard": "c++17",
      "intelliSenseMode": "macos-clang-arm64",
      "includePath": [
        "${workspaceFolder}/src/cpp/**",
        "${env:HOME}/.local/wasi-sdk/share/wasi-sysroot/include/c++/v1",
        "${env:HOME}/.local/wasi-sdk/share/wasi-sysroot/include"
      ]
    },
    {
      "name": "Linux (wasi-sdk C++17 stdlib)",
      "compilerPath": "/opt/wasi-sdk/bin/clang++",
      "cppStandard": "c++17",
      "intelliSenseMode": "linux-clang-x64",
      "includePath": [
        "${workspaceFolder}/src/cpp/**",
        "/opt/wasi-sdk/share/wasi-sysroot/include/c++/v1",
        "/opt/wasi-sdk/share/wasi-sysroot/include"
      ]
    }
  ]
}
