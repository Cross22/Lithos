{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Lithos in Chrome (C++ DWARF)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "enableDWARF": true,
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug",
      "runtimeArgs": [
        "--no-first-run",
        "--no-default-browser-check"
      ],
      "preLaunchTask": "Dev Server (Debug WASM + Vite)"
    },
    {
      "name": "Attach to Chrome (C++ DWARF, Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "urlFilter": "http://localhost:3000/*",
      "webRoot": "${workspaceFolder}",
      "enableDWARF": true
    },
    {
      "name": "Debug Lithos in Edge (C++ DWARF)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "enableDWARF": true,
      "userDataDir": "${workspaceFolder}/.vscode/.edge-debug",
      "runtimeArgs": [
        "--no-first-run",
        "--no-default-browser-check"
      ],
      "preLaunchTask": "Dev Server (Debug WASM + Vite)"
    },
    {
      "name": "Launch Lithos in Chrome (Release WASM)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-debug",
      "preLaunchTask": "Dev Server (Release WASM + Vite)"
    }
  ]
}
